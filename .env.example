# PDFNest Python Worker Environment Configuration
# Copy this file to .env for local development

# Application Config
APP_NAME="Platen PDF Worker"
APP_VERSION=0.1.0
APP_ENV=development
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:8080

# Service URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8080
WORKER_URL=http://localhost:8000

# Redis Job Queue & Cache (Required)
REDIS_URL=redis://localhost:6379/0
JOB_TTL_SECONDS=86400

# Cloudflare R2 Storage (Secrets)
R2_BUCKET=pdfnest-storage
R2_ACCESS_KEY=<r2-access-key-id>
R2_SECRET_KEY=<r2-secret-access-key>
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
FILE_ENCRYPTION_KEY=<set-32-byte-hex-secret-in-deployment>

# Dramatiq Worker Process Configuration (P1 Resource Protection)
DRAMATIQ_PROCESSES=2

# OCR Text V2 consumer engine (safe default; SDK is explicit opt-in)
OCR_TEXT_ENGINE=internal

# Searchable PDF V2 consumer engine (safe default; SDK is explicit opt-in)
SEARCHABLE_PDF_ENGINE=internal

# Document Extraction V2 consumer engine (safe default; SDK is explicit opt-in)
DOCUMENT_EXTRACTION_ENGINE=internal

# PDF-to-Markdown V2 consumer engine (safe default; SDK is explicit opt-in)
PDF_TO_MARKDOWN_ENGINE=internal

# OCR-aware Highlight/Underline/Strikeout V2 consumer engine (safe default; SDK is explicit opt-in)
OCR_MARKUP_ENGINE=internal

# General Editor OCR V2 consumer engine (safe default; SDK is explicit opt-in; Studio remains internal)
EDITOR_OCR_ENGINE=internal
